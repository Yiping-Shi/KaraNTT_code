// Define struct types for matrix entries
typedef struct packed {
  logic [$clog2(`EVAL_ROWS)-1:0] row;
  logic [$clog2(`EVAL_COLS)-1:0] col;
  logic [29:0]                   value;
} eval_entry_t;

typedef struct packed {
  logic [$clog2(`POSTPROC_ROWS)-1:0] row;
  logic [$clog2(`POSTPROC_COLS)-1:0] col;
  logic [29:0]                       value;
} postproc_entry_t;

